{
  "name": "dsh-pet-agent-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Stream DeepSeek Harness session activity into the DesktopPet agent inbox, so the pet can react to running / waiting / finished turns.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "mapping.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "desktop-pet"
  ],
  "license": "MIT"
}
