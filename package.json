{
  "name": "desktop-pet",
  "private": true,
  "version": "0.2.4",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:plugins && tsc && vite build",
    "typecheck:plugins": "tsc -p tsconfig.plugins.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:debug": "node tools/dev-debug.mjs",
    "lint": "biome lint .",
    "check:docs": "node tools/check-docs.mjs",
    "check:shape": "node tools/check-command-shape.mjs",
    "unit:astock": "node --test --test-concurrency=1 tests/unit/unit-market.mjs tests/unit/unit-aux.mjs",
    "unit:runtime": "node --import ./tests/unit/ts-loader.mjs --test tests/unit/unit-runtime.mjs",
    "unit:plugins": "node --test tests/unit/unit-plugins.mjs tests/unit/unit-goat-gauge.mjs",
    "unit:sdk": "node --test tests/unit/unit-sdk-topics.mjs",
    "unit:capabilities": "node --import ./tests/unit/ts-loader.mjs --test tests/unit/unit-capabilities.mjs",
    "unit:manifest": "node --import ./tests/unit/ts-loader.mjs --test tests/unit/unit-manifest-schema.mjs",
    "unit:errors": "node --import ./tests/unit/ts-loader.mjs --test tests/unit/unit-error-codes.mjs",
    "unit:worker-host": "node --import ./tests/unit/ts-loader.mjs --test tests/unit/unit-worker-host.mjs",
    "unit:dsh-bridge": "node --import ./tests/unit/ts-loader.mjs --test tests/unit/unit-dsh-bridge.mjs",
    "unit": "node --import ./tests/unit/ts-loader.mjs --test --test-concurrency=1 tests/unit/unit-market.mjs tests/unit/unit-aux.mjs tests/unit/unit-runtime.mjs tests/unit/unit-plugins.mjs tests/unit/unit-sdk-topics.mjs tests/unit/unit-capabilities.mjs tests/unit/unit-astock-views.mjs tests/unit/unit-manifest-schema.mjs tests/unit/unit-error-codes.mjs tests/unit/unit-worker-host.mjs tests/unit/unit-widget-protocol.mjs tests/unit/unit-widget-worker.mjs tests/unit/unit-widget-migrations.mjs tests/unit/unit-badge-arbiter.mjs tests/unit/unit-png.mjs tests/unit/unit-goat-gauge.mjs tests/unit/unit-nsis-hook.mjs tests/unit/unit-secrets-bridge.mjs tests/unit/unit-skin-manifest.mjs tests/unit/unit-settings-echo.mjs tests/unit/unit-dsh-bridge.mjs",
    "verify": "node tests/e2e/verify-isolation.mjs",
    "verify:agent": "node tests/e2e/verify-agent-bridge.mjs",
    "verify:game": "node tests/e2e/verify-game-mode.mjs",
    "verify:skin": "node tests/e2e/verify-skins.mjs",
    "verify:todo": "node tests/e2e/verify-todo.mjs",
    "verify:worker": "node tests/e2e/verify-worker.mjs",
    "verify:release": "node tests/e2e/verify-release.mjs",
    "verify:astock": "node tests/e2e/verify-astock.mjs",
    "verify:http": "node tests/e2e/verify-http.mjs",
    "verify:goat-gauge": "node tests/e2e/verify-goat-gauge.mjs",
    "verify:drag": "node tests/e2e/verify-pet-drag.mjs",
    "verify:dsh": "node tests/e2e/verify-dsh-bridge.mjs",
    "unit:widget": "node --import ./tests/unit/ts-loader.mjs --test --test-concurrency=1 tests/unit/unit-widget-protocol.mjs tests/unit/unit-widget-worker.mjs tests/unit/unit-widget-migrations.mjs tests/unit/unit-badge-arbiter.mjs",
    "unit:migrate": "node --import ./tests/unit/ts-loader.mjs --test --test-concurrency=1 tests/unit/unit-widget-migrations.mjs",
    "unit:echo": "node --import ./tests/unit/ts-loader.mjs --test --test-concurrency=1 tests/unit/unit-settings-echo.mjs",
    "e2e": "node tools/e2e-run.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
